<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ProfileActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aspen_green">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarProfile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Student Profile &amp; Settings"
            app:titleTextColor="@color/dark_text"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: User Profile Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivProfilePhoto"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:src="@drawable/mascot_minty"
                            android:scaleType="centerCrop"
                            android:contentDescription="Profile photo" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnChoosePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            app:fabCustomSize="36dp"
                            app:maxImageSize="18dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/white"
                            app:backgroundTint="@color/aspen_green"
                            android:contentDescription="Change photo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text" />

                        <ImageView
                            android:id="@+id/btnEditProfileName"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="@color/aspen_green_dark"
                            android:contentDescription="Edit Name"
                            android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="student@minty.app"
                        android:textSize="14sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvJoinDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Member since 2026"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" />

                    <!-- Badges Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tvGardenLevelBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="🌱 Little Seed"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/aspen_green_dark"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvStreakBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_cream"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="🔥 0 Days"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Student Productivity Stats -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Productivity Summary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Lifetime focus -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvStatTotalFocus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 min"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/aspen_green_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Focus Earned"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <!-- Tasks Completed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvStatTasksDone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/aspen_green_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tasks Done"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <!-- Balance -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvStatBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/aspen_green_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Minty Minutes"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: The Little Memory Library -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpenMemoryLibrary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#C5D9C0"
                app:cardBackgroundColor="@color/card_white"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="📖"
                        android:textSize="22sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="The Little Memory Library"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View your illustrated milestones, blooms &amp; reflections"
                            android:textSize="12sp"
                            android:textColor="@color/aspen_green_dark" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/aspen_green_dark"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Accountability Buddy & Sharing -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accountability Buddies"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay motivated together with two-way productivity sharing."
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <!-- Two-Way Hub Button -->
                    <Button
                        android:id="@+id/btnOpenBuddyNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Open Buddy Hub &amp; Network 🌱"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingVertical="12dp"
                        android:backgroundTint="@color/aspen_green"
                        android:textColor="@color/white"
                        app:cornerRadius="20dp" />

                    <!-- SMS Buddy Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/pale_mint"
                        android:layout_marginVertical="14dp" />

                    <TextView
                        android:id="@+id/tvBuddyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Contact Buddy: None selected"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:id="@+id/tvBuddyPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnChooseBuddy"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Choose Contact"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/aspen_green_dark"
                            app:strokeColor="@color/aspen_green_dark"
                            app:cornerRadius="18dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnSendProgress"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Send SMS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/aspen_green_dark"
                            app:strokeColor="@color/aspen_green_dark"
                            app:cornerRadius="18dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Settings & Preferences -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferences"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text"
                        android:layout_marginBottom="12dp" />

                    <!-- Daily Reminders Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Morning Study Reminders"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/dark_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily encouragement at 8:00 AM"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchDailyReminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/aspen_green" />
                    </LinearLayout>

                    <!-- Focus Sound / Haptics Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Haptic Feedback"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/dark_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gentle vibration on task completion"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchHaptics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/aspen_green" />
                    </LinearLayout>

                    <!-- Timer Completion Chime / Sound -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Completion Chime"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/dark_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Soft tone when focus timer reaches zero"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/aspen_green" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Developer Tools Button (Visible when developer mode is unlocked) -->
            <Button
                android:id="@+id/btnOpenDevTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛠️ Open Developer Diagnostics"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingVertical="12dp"
                android:backgroundTint="@color/warm_beige"
                android:textColor="@color/dark_text"
                app:cornerRadius="20dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign Out"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="12dp"
                android:textColor="@color/dark_text"
                app:strokeColor="@color/text_muted"
                app:cornerRadius="20dp"
                android:layout_marginBottom="16dp" />

            <!-- App Version & Developer Unlock Trigger -->
            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minty v1.0 • Focus a little. Grow a lot."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:paddingVertical="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
