<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSeedEmoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🌰"
            android:textSize="26sp"
            android:background="@drawable/bg_chip_cream"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSeedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunflower Seeds"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text" />

            <TextView
                android:id="@+id/tvSeedDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radiant yellow bloom turning toward morning sun."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSeedRequirement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlocked"
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="@color/aspen_green_dark"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSeedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="x 2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/aspen_green_dark"
            android:layout_marginStart="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
