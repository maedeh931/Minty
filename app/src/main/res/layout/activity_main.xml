<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="72dp"
        android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- System Status Banner Card (Hidden by default) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/mint"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvStatusBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/leaf_dark" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mascot & Greeting in Rounded Cream Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/cream"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivMascot"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_minty"
                    android:contentDescription="Minty the mascot"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus a little.\nGrow a lot."
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Earn your scroll time!"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- User Greeting & Logout Row under Greeting Card -->
        <LinearLayout
            android:id="@+id/rowUserGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivProfileSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop"
                android:src="@drawable/mascot_minty"
                android:contentDescription="Profile photo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvUserGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hi, Minty Friend"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/leaf_dark"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- A Little Note from Minty Card (Phase 5) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLittleNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="#C5D9C0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/pale_mint"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvNoteEmoji"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="🌱"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvNoteHeadline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="A Little Note from Minty 🍃"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:id="@+id/tvNoteCategoryPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:backgroundTint="@color/aspen_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Encouragement"
                        android:textColor="@color/dark_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <ImageButton
                        android:id="@+id/btnRefreshNote"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_popup_sync"
                        android:contentDescription="Refresh note from Minty"
                        app:tint="@color/dark_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoteMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Breathe in the calm morning air. You don't have to conquer everything, just begin gently."
                    android:textSize="13sp"
                    android:textColor="@color/dark_text"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quote of the Day Card (Rounded 20dp, soft elevation) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✨ Quote of the Day"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/leaf_dark" />

                    <ProgressBar
                        android:id="@+id/pbQuoteLoading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/leaf"
                        android:visibility="gone"
                        android:layout_marginEnd="8dp" />

                    <ImageButton
                        android:id="@+id/btnRefreshQuote"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_popup_sync"
                        android:contentDescription="Refresh quote"
                        app:tint="@color/leaf_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading quote..."
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="@color/text_dark"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvQuoteAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:gravity="end"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Balance Card: 20dp corners, soft elevation, gradient from leaf to leaf_dark -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_balance_card"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="22dp">

                <!-- Big White Bold Balance Text -->
                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/balance_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center" />

                <!-- Streak and Title Level Chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <!-- Streak Chip (cream fill with text_dark) -->
                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_cream"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="Streak: 0 days"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginEnd="8dp" />

                    <!-- Title Level Chip (mint fill with leaf_dark) -->
                    <TextView
                        android:id="@+id/tvUserLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="Beginner"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/leaf_dark" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Garden Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGardenPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/warm_beige"
            app:cardBackgroundColor="@color/card_white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivGardenPreviewPlant"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_flower_mint"
                    android:contentDescription="Active garden plant"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌱 Virtual Garden"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/aspen_green_dark" />

                        <TextView
                            android:id="@+id/tvGardenPreviewStage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Sprout"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/aspen_green_dark" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGardenPreviewPlantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minty Sprout"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginTop="2dp" />

                    <ProgressBar
                        android:id="@+id/pbGardenPreview"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="35"
                        android:progressTint="@color/aspen_green"
                        android:progressBackgroundTint="@color/pale_mint"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvGardenPreviewPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 / 45 pts to next stage"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/aspen_green_dark"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rest Mode Quick Access Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRestMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3D5241"
            app:cardBackgroundColor="#1B261D"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvRestCardIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="✨"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRestCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peaceful Rest Mode"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#EAF2E7" />

                    <TextView
                        android:id="@+id/tvRestCardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recharge under the moonlit garden • Streaks preserved"
                        android:textSize="11sp"
                        android:textColor="#A8C3A0" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#A8C3A0"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The Little Memory Library Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMemoryLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#C5D9C0"
            app:cardBackgroundColor="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="📖"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Little Memory Library"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Milestones, garden scrapbooks &amp; reflections"
                        android:textSize="11sp"
                        android:textColor="@color/aspen_green_dark" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/aspen_green_dark"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Achievement Scrapbook Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScrapbook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#C5D9C0"
            app:cardBackgroundColor="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🏆"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Achievement Scrapbook"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily quests, flower album &amp; spirit whispers"
                        android:textSize="11sp"
                        android:textColor="@color/aspen_green_dark" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/aspen_green_dark"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Plan Tomorrow Evening Action Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlanTomorrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/warm_cream"
            app:cardBackgroundColor="@color/cream"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🌙"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Tomorrow"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review today's goals &amp; set tomorrow's focus"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/leaf_dark"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Planner Section Header & Filter Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvPlannerSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily Focus Plan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text" />

                <TextView
                    android:id="@+id/tvPlannerTaskCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="0 tasks"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/leaf_dark" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTaskFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterToday"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Today ☀️"
                        app:chipBackgroundColor="@color/mint"
                        android:textColor="@color/leaf_dark" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterTomorrow"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tomorrow 🌙"
                        app:chipBackgroundColor="@color/mint"
                        android:textColor="@color/leaf_dark" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterUpcoming"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming 📅"
                        app:chipBackgroundColor="@color/mint"
                        android:textColor="@color/leaf_dark" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterOverdue"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overdue ⚠️"
                        app:chipBackgroundColor="@color/soft_pink"
                        android:textColor="#C62828" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Pending 📋"
                        app:chipBackgroundColor="@color/mint"
                        android:textColor="@color/leaf_dark" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Container for Pending Tasks and Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <!-- RecyclerView for Pending Tasks: height wrap_content, nestedScrollingEnabled false -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/task_item" />

            <!-- Empty State Container with mascot above message -->
            <LinearLayout
                android:id="@+id/tvEmptyPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/mascot_minty"
                    android:scaleType="fitCenter"
                    android:contentDescription="Minty the mascot"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_pending_tasks"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:gravity="center" />
            </LinearLayout>

        </FrameLayout>

        <!-- Button to Navigate to Accountability Buddy Hub: rounded 24dp, mint, leaf_dark text -->
        <Button
            android:id="@+id/btnBuddyHub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accountability Buddy Hub 🌱"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="14dp"
            android:backgroundTint="@color/mint"
            android:textColor="@color/leaf_dark"
            app:cornerRadius="24dp"
            android:layout_marginBottom="12dp" />

        <!-- Button to Navigate to SpendActivity: rounded 24dp, star_yellow, text_dark -->
        <Button
            android:id="@+id/btnStartScrolling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_scrolling"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="14dp"
            android:backgroundTint="@color/star_yellow"
            android:textColor="@color/text_dark"
            app:cornerRadius="24dp"
            android:layout_marginBottom="12dp" />

        <!-- Button to Navigate to AddTaskActivity: rounded 24dp, leaf, bold white text -->
        <Button
            android:id="@+id/btnAddTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_task"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingVertical="14dp"
            android:backgroundTint="@color/leaf"
            android:textColor="@color/white"
            app:cornerRadius="24dp"
            android:layout_marginBottom="12dp" />

        <!-- Action Buttons Row: History & Feedback -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Button to Navigate to HistoryActivity: outlined with leaf_dark, rounded 24dp -->
            <Button
                android:id="@+id/btnHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_history"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="14dp"
                android:textColor="@color/leaf_dark"
                app:strokeColor="@color/leaf_dark"
                app:strokeWidth="2dp"
                app:cornerRadius="24dp"
                android:layout_marginEnd="6dp" />

            <!-- Button to Navigate to FeedbackActivity: outlined with leaf_dark, rounded 24dp -->
            <Button
                android:id="@+id/btnFeedback"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_feedback"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingVertical="14dp"
                android:textColor="@color/leaf_dark"
                app:strokeColor="@color/leaf_dark"
                app:strokeWidth="2dp"
                app:cornerRadius="24dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Unified Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/card_white"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/aspen_green_dark"
        app:itemTextColor="@color/aspen_green_dark"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
