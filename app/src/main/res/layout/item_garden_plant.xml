<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivPlantIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_flower_mint"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:contentDescription="Plant icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlantCardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minty"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text" />

            <TextView
                android:id="@+id/tvPlantCardDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mint Herb • Sprout (15 pts)"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

            <ProgressBar
                android:id="@+id/pbPlantCardProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/aspen_green"
                android:progressBackgroundTint="@color/pale_mint" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlantCardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Active"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/aspen_green_dark"
            android:layout_marginStart="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
