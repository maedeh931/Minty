<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Title & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvChallengeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="300 Minutes of Focus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <TextView
                android:id="@+id/tvChallengeStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Active 🟢"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/leaf_dark" />
        </LinearLayout>

        <!-- Target & Deadline Subtitle -->
        <TextView
            android:id="@+id/tvChallengeMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target: 300 minutes • Ends in 4 days"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="14dp" />

        <!-- User Progress Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvMyNameProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="You:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:id="@+id/tvMyStatsProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="180 / 300 min (60%)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/leaf_dark" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbMyProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="60"
                android:progressTint="@color/leaf" />
        </LinearLayout>

        <!-- Buddy Progress Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvBuddyNameProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Buddy:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:id="@+id/tvBuddyStatsProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="220 / 300 min (73%)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbBuddyProgress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="73"
                android:progressTint="@color/star_yellow" />
        </LinearLayout>

        <!-- Pending Invitation Actions -->
        <LinearLayout
            android:id="@+id/layoutChallengeActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAcceptChallenge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accept Challenge 🎯"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="10dp"
                android:backgroundTint="@color/leaf"
                android:textColor="@color/white"
                app:cornerRadius="20dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnDeclineChallenge"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Decline"
                android:textSize="13sp"
                android:paddingVertical="10dp"
                android:textColor="@color/text_muted"
                app:strokeColor="@color/mint"
                app:cornerRadius="20dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
