<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAchBadge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🏆"
            android:textSize="24sp"
            android:background="@drawable/bg_chip_cream"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Bloom"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text" />

            <TextView
                android:id="@+id/tvAchDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bloom your first flower in the garden."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvAchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlocked"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/aspen_green_dark"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
