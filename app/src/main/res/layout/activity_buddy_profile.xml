<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarBuddyProfile"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/card_white"
            app:title="Shared Productivity 🌱"
            app:titleTextColor="@color/text_dark"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="32dp">

                <!-- 1. Header Card: Profile details & Primary Buddy toggle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/card_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/ivDashboardAvatar"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/mascot_minty"
                            android:scaleType="centerCrop"
                            android:contentDescription="Buddy Avatar"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvDashboardName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Minty Friend"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark" />

                        <TextView
                            android:id="@+id/tvDashboardUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@username"
                            android:textSize="14sp"
                            android:textColor="@color/leaf_dark"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvDashboardLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Focused 🌱"
                            android:textSize="12sp"
                            android:textColor="@color/text_muted"
                            android:layout_marginBottom="12dp" />

                        <Button
                            android:id="@+id/btnTogglePrimaryFromProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★ Set as Primary Buddy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="20dp"
                            android:backgroundTint="@color/star_yellow"
                            android:textColor="@color/text_dark"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Today's Productivity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/card_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today's Productivity 📅"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:layout_marginBottom="12dp" />

                        <!-- Focus Time Today -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Focus Time Today"
                                android:textSize="13sp"
                                android:textColor="@color/text_muted" />

                            <TextView
                                android:id="@+id/tvFocusTodayValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 min / 120 min goal"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/leaf_dark" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbFocusToday"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:progressTint="@color/leaf"
                            android:layout_marginBottom="14dp" />

                        <!-- Stats Pills Row: Tasks & Streak -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:background="@drawable/bg_chip_cream"
                                android:padding="12dp"
                                android:gravity="center"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:id="@+id/tvTasksTodayValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/leaf_dark" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tasks Done Today"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:background="@drawable/bg_chip_cream"
                                android:padding="12dp"
                                android:gravity="center"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:id="@+id/tvStreakDaysValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 days"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_dark" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Daily Focus Streak 🔥"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Weekly Comparison Card: You vs Buddy -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/card_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly Comparison (You vs Buddy) 📈"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:layout_marginBottom="12dp" />

                        <!-- Your Weekly Focus -->
                        <TextView
                            android:id="@+id/tvMyWeeklyStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You: 0 mins focus"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/leaf_dark"
                            android:layout_marginBottom="4dp" />

                        <ProgressBar
                            android:id="@+id/pbMyWeekly"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:progressTint="@color/leaf"
                            android:layout_marginBottom="12dp" />

                        <!-- Buddy's Weekly Focus -->
                        <TextView
                            android:id="@+id/tvBuddyWeeklyStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buddy: 0 mins focus"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:layout_marginBottom="4dp" />

                        <ProgressBar
                            android:id="@+id/pbBuddyWeekly"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:progressTint="@color/star_yellow" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Minty Balance Card (Privacy Protected) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="@color/card_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/mascot_minty"
                            android:contentDescription="Balance Icon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Minty Minutes Balance"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_dark" />

                            <TextView
                                android:id="@+id/tvDashboardBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hidden by buddy's privacy settings 🔒"
                                android:textSize="12sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom Button: Send Encouragement -->
                <Button
                    android:id="@+id/btnSendEncouragementFromDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send Encouragement ✨"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="14dp"
                    android:backgroundTint="@color/leaf"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
