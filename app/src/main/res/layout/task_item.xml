<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/warm_cream"
    app:cardBackgroundColor="@color/card_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Completion Checkbox tinted with leaf -->
        <CheckBox
            android:id="@+id/cbComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/aspen_green" />

        <!-- Middle Column: Title, Description, Meta Tags -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text" />

            <!-- Description (Optional) -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_marginTop="2dp" />

            <!-- Meta Badges Flow Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <!-- Time / Day Badge -->
                <TextView
                    android:id="@+id/tvTimeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Today"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/leaf_dark"
                    android:layout_marginEnd="6dp" />

                <!-- Category Badge -->
                <TextView
                    android:id="@+id/tvCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_cream"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Study"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text"
                    android:layout_marginEnd="6dp" />

                <!-- Overdue Alert Badge (hidden by default) -->
                <TextView
                    android:id="@+id/tvOverdueBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_cream"
                    android:backgroundTint="@color/soft_pink"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="⚠️ Overdue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#C62828"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right Side: Minutes Badge & Overflow Menu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <!-- Minutes Reward Badge -->
            <TextView
                android:id="@+id/tvMinutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/leaf_dark" />

            <!-- 3-Dots Action Button -->
            <ImageView
                android:id="@+id/btnTaskMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/text_muted"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Task options"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
