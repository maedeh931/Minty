<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".FeedbackActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvFeedbackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_feedback"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Input Fields Card: 20dp corners, card_white -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/card_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxStrokeColor="@color/leaf"
                        app:hintTextColor="@color/leaf"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFeedbackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Feedback Title"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_muted"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/leaf"
                        app:hintTextColor="@color/leaf"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFeedbackMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Message"
                            android:minLines="3"
                            android:gravity="top|start"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_muted"
                            android:inputType="textMultiLine|textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HTTP Action Buttons: Send (POST), Update (PUT), Delete (DELETE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Send (POST) Button -->
                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Send"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingVertical="12dp"
                    android:backgroundTint="@color/leaf"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp"
                    android:layout_marginEnd="4dp" />

                <!-- Update (PUT) Button -->
                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Update"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingVertical="12dp"
                    android:backgroundTint="@color/star_yellow"
                    android:textColor="@color/text_dark"
                    app:cornerRadius="24dp"
                    android:layout_marginHorizontal="4dp" />

                <!-- Delete (DELETE) Button -->
                <Button
                    android:id="@+id/btnDelete"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingVertical="12dp"
                    android:textColor="@color/leaf_dark"
                    app:strokeColor="@color/leaf_dark"
                    app:strokeWidth="2dp"
                    app:cornerRadius="24dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/pbFeedbackLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/leaf"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Result Card (20dp corners, cream background) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/cream">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResultHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Response Result"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvResultStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perform an action above to see HTTP response."
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/leaf_dark"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvResultJson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_dark" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
