<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background"
    tools:context=".HistoryActivity">

    <!-- Screen Title in text_dark -->
    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_completed_tasks"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Total Minutes Earned Highlight Chip: cream fill with text_dark text -->
    <TextView
        android:id="@+id/tvTotalEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total earned: 0 min"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:background="@drawable/bg_chip_cream"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="20dp" />

    <!-- Container for Completed Tasks ListView and Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ListView for Completed Tasks -->
        <ListView
            android:id="@+id/lvCompletedTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp" />

        <!-- Empty State Container with mascot above message -->
        <LinearLayout
            android:id="@+id/tvEmptyHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/mascot_minty"
                android:scaleType="fitCenter"
                android:contentDescription="Minty the mascot"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_no_tasks"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:gravity="center" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
