<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarBuddy"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/card_white"
            app:title="Accountability Buddy Hub 🌱"
            app:titleTextColor="@color/text_dark"
            app:navigationIcon="?attr/homeAsUpIndicator">

            <Button
                android:id="@+id/btnPrivacySettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Privacy 🔒"
                android:textSize="12sp"
                android:textColor="@color/leaf_dark"
                android:layout_marginEnd="8dp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Profile & Invite Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMyInvite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/mascot_minty"
                    android:contentDescription="Mascot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tvMyUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@username"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:id="@+id/tvMyInviteCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code: MINT-XXXX"
                        android:textSize="12sp"
                        android:textColor="@color/leaf_dark" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnShareInvite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share Invite 🔗"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:backgroundTint="@color/star_yellow"
                    android:textColor="@color/text_dark"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Segmented Tab Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tabBuddies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buddies 👥"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:backgroundTint="@color/leaf"
                    android:textColor="@color/white"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/tabFindRequests"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find &amp; Requests 🔍"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_dark"
                    app:strokeColor="@color/mint"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/tabChallenges"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Challenges 🎯"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_dark"
                    app:strokeColor="@color/mint"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/tabEncouragement"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encourage ✨"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_dark"
                    app:strokeColor="@color/mint"
                    app:cornerRadius="20dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB 1: BUDDY LIST -->
            <LinearLayout
                android:id="@+id/containerTabBuddies"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBuddies"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />

                <!-- Empty State Buddies -->
                <LinearLayout
                    android:id="@+id/layoutEmptyBuddies"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/mascot_minty"
                        android:contentDescription="Minty Mascot"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No connected buddies yet!"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect with study friends to view shared focus progress and take on challenges together."
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnEmptyFindBuddy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find Friends 🔍"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="20dp"
                        android:backgroundTint="@color/leaf"
                        android:textColor="@color/white"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 2: FIND & REQUESTS -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/containerTabFindRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="24dp">

                    <!-- Search Input Box -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/mint"
                        app:cardBackgroundColor="@color/card_white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="8dp">

                            <EditText
                                android:id="@+id/etSearchUser"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Enter @username or MINT-XXXX code"
                                android:textSize="14sp"
                                android:background="@null"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp"
                                android:textColor="@color/text_dark"
                                android:textColorHint="@color/text_muted"
                                android:inputType="text" />

                            <Button
                                android:id="@+id/btnSearchUser"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Search"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:backgroundTint="@color/leaf"
                                android:textColor="@color/white"
                                app:cornerRadius="18dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Search Results Section -->
                    <TextView
                        android:id="@+id/tvSearchResultsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search Results"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSearchResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <!-- Incoming Requests Section -->
                    <TextView
                        android:id="@+id/tvIncomingRequestsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Incoming Requests 📩"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvIncomingRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/tvEmptyIncoming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No pending incoming requests."
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="16dp" />

                    <!-- Sent Requests Section -->
                    <TextView
                        android:id="@+id/tvSentRequestsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sent Requests 📤"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="6dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSentRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvEmptySent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No sent requests pending."
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- TAB 3: CHALLENGES -->
            <LinearLayout
                android:id="@+id/containerTabChallenges"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnCreateChallenge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Create Study Challenge 🎯"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingVertical="12dp"
                    android:backgroundTint="@color/star_yellow"
                    android:textColor="@color/text_dark"
                    app:cornerRadius="20dp"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChallenges"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />

                <LinearLayout
                    android:id="@+id/layoutEmptyChallenges"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No active challenges"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create a focus minutes or task streak challenge with a buddy to keep each other motivated!"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 4: ENCOURAGEMENT MESSAGES -->
            <LinearLayout
                android:id="@+id/containerTabEncouragement"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <!-- Buddy Selector Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat with: "
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvCurrentChatBuddy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Select a buddy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/leaf_dark" />

                    <Button
                        android:id="@+id/btnSwitchChatBuddy"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Switch Buddy"
                        android:textSize="12sp"
                        android:textColor="@color/leaf_dark"
                        android:minHeight="0dp"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Messages List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMessages"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="8dp" />

                <!-- Quick Message Pills Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pillPraise1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Keep growing! 🌱"
                            android:textSize="12sp"
                            android:textColor="@color/leaf_dark"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/pillPraise2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="You've got this! 💪"
                            android:textSize="12sp"
                            android:textColor="@color/leaf_dark"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/pillPraise3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Time to focus! ⏱️"
                            android:textSize="12sp"
                            android:textColor="@color/leaf_dark"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/pillPraise4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Proud of your progress! ✨"
                            android:textSize="12sp"
                            android:textColor="@color/leaf_dark"
                            android:layout_marginEnd="6dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/pillPraise5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Let's complete goals! 🎯"
                            android:textSize="12sp"
                            android:textColor="@color/leaf_dark"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Custom Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etCustomMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Send encouragement..."
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="@drawable/bg_input_field"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:maxLines="3"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSendMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/leaf"
                        android:textColor="@color/white"
                        app:cornerRadius="18dp" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Unified Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/card_white"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/aspen_green_dark"
        app:itemTextColor="@color/aspen_green_dark"
        app:labelVisibilityMode="labeled" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
