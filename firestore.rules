rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user-private data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /garden/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // The Little Memory Library milestones & private reflection notes
      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public searchable profiles (username, invite code, title)
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared productivity statistics (opt-in privacy flags)
    match /sharedStats/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Mutual buddy connection requests
    match /buddyRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Active mutual buddy connections
    match /buddyConnections/{connectionId} {
      allow read, write: if request.auth != null;
    }

    // Two-way encouragement messages
    match /buddyMessages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Collaborative study challenges
    match /challenges/{challengeId} {
      allow read, write: if request.auth != null;
    }
  }
}
